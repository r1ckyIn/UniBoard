# Database
DATABASE_URL=postgresql+asyncpg://uniboard:devpassword@localhost:5432/uniboard_dev
TEST_DATABASE_URL=postgresql+asyncpg://uniboard:devpassword@localhost:5432/uniboard_test

# Platform API Tokens
CANVAS_API_TOKEN=your_canvas_token_here
ED_API_TOKEN=your_ed_token_here

# API Base URLs
CANVAS_BASE_URL=https://canvas.sydney.edu.au/api/v1
ED_BASE_URL=https://edstem.org/api

# Encryption (generate a 64-char hex string for 32 bytes)
ENCRYPTION_KEY=generate-a-64-char-hex-string-for-32-bytes

# Auth
SECRET_KEY=dev-secret-change-in-production

# Debug
DEBUG=true
LOG_LEVEL=INFO
